#!/bin/sh
# Release runtime env for kelixip (mix release picks this up automatically).
#
# The package's environment file, which the systemd unit also reads. Sourcing it
# here is what makes `kelictl`, run by hand, target the same node with the same
# cookie and the same TOML files as the service — one place to edit, not two.
# The environment still wins, so a per-invocation override keeps working.
if [ -r /etc/sysconfig/kelixip ]; then
  _keep_node="${RELEASE_NODE-}"
  _keep_cookie="${RELEASE_COOKIE-}"
  _keep_config="${KELIXIP_CONFIG-}"
  _keep_domains="${KELIXIP_DOMAINS-}"
  . /etc/sysconfig/kelixip
  if [ -n "$_keep_node" ]; then RELEASE_NODE="$_keep_node"; fi
  if [ -n "$_keep_cookie" ]; then RELEASE_COOKIE="$_keep_cookie"; fi
  if [ -n "$_keep_config" ]; then KELIXIP_CONFIG="$_keep_config"; fi
  if [ -n "$_keep_domains" ]; then KELIXIP_DOMAINS="$_keep_domains"; fi
fi

# Start the node distributed so `bin/kelixip rpc` (used by bin/kelictl) can reach
# it. RELEASE_NODE must match server.node_name in config.toml — set both in
# /etc/sysconfig/kelixip for a packaged deployment; the cookie defaults to the
# per-host secret %post generated in releases/COOKIE.
export RELEASE_DISTRIBUTION=name
export RELEASE_NODE="${RELEASE_NODE:-kelixip@127.0.0.1}"

# Scratch dir the boot script writes each boot's runtime config into. The default
# is inside the release tree, which the package installs root-owned — the systemd
# unit therefore points it at /run/kelixip (RuntimeDirectory=) so the unprivileged
# service can write there.
export RELEASE_TMP="${RELEASE_TMP:-$RELEASE_ROOT/tmp}"

# Where the TOML configuration lives. config/runtime.exs reads these two at every
# boot and defaults them to the FHS paths, so exporting them here is only useful
# to run the release from a checkout (or to override from the systemd unit).
export KELIXIP_CONFIG="${KELIXIP_CONFIG:-/etc/kelixip/config.toml}"
export KELIXIP_DOMAINS="${KELIXIP_DOMAINS:-/etc/kelixip/domains.toml}"
