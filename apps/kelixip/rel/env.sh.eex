#!/bin/sh
# Release runtime env for kelixip (mix release picks this up automatically).
#
# Start the node distributed so `bin/kelixip rpc` (used by bin/kelictl) can reach
# it. Adjust RELEASE_NODE to match server.node_name in config.toml for a real
# deployment; the cookie is the shared secret in releases/COOKIE.
export RELEASE_DISTRIBUTION=name
export RELEASE_NODE="${RELEASE_NODE:-kelixip@127.0.0.1}"

# Where the TOML configuration lives. config/runtime.exs reads these two at every
# boot and defaults them to the FHS paths, so exporting them here is only useful
# to run the release from a checkout (or to override from the systemd unit).
export KELIXIP_CONFIG="${KELIXIP_CONFIG:-/etc/kelixip/config.toml}"
export KELIXIP_DOMAINS="${KELIXIP_DOMAINS:-/etc/kelixip/domains.toml}"
