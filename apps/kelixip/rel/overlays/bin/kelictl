#!/bin/sh
# kelictl — thin admin CLI over Kelix.Control (design §10.2).
#
# Installed as /usr/sbin/kelictl. It runs the CLI *inside* the live kelixip node
# via `kelixip rpc`, so it needs no SIP stack and shares the node's cookie. The
# CLI logic + rendering live in Kelix.Control.CLI; this overlay only forwards argv.
set -e

# Resolve our own symlink chain: the package links /usr/sbin/kelictl here, and the
# sibling `kelixip` script must be looked up next to the REAL file, not next to the
# link. (The release's own bin/kelixip does the same for RELEASE_ROOT.)
SELF="$0"
while [ -h "$SELF" ]; do
  LINK="$(readlink "$SELF")"
  case "$LINK" in
    /*) SELF="$LINK" ;;
    *) SELF="$(dirname "$SELF")/$LINK" ;;
  esac
done
DIR="$(cd "$(dirname "$SELF")" && pwd)"

# Forward argv as an Elixir **list**, one element per argument, quoted and escaped.
#
# It used to be joined into one string ("$*") for the CLI to re-split, and that lost
# the shell's own quoting: `name='Sales weekly'` arrived as two arguments and
# `muted='{"audio":true}'` lost its inner quotes to the re-split — the very forms the
# documentation shows. A list has no re-splitting to get wrong.
ARGS=""
for arg in "$@"; do
  ESC=$(printf '%s' "$arg" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')
  if [ -z "$ARGS" ]; then ARGS="\"$ESC\""; else ARGS="$ARGS, \"$ESC\""; fi
done
# `kelictl help` has to answer when the node is DOWN — that is exactly when an
# operator reaches for it — and `rpc` cannot: it runs the CLI inside the live node.
# So the help forms the CLI answers from its own text are run in a throw-away VM
# (`eval`, which loads the release's code without needing the service), and
# everything else keeps going through `rpc`.
#
# Only those forms. `kelictl <module> help` is rendered from the declaration of a
# LOADED module, so it needs the live node like any other module command; an `eval`
# would find no module loaded and no Kelix.Control running.

# `kelictl complete <words…> <prefix>` is the shell hook of the completion script
# (/usr/share/bash-completion/completions/kelictl), not an operator command. It is
# the one form that tries BOTH: `rpc` first, because the modules' commands and the
# object names it offers are the live node's, then `eval` when the node did not
# answer, which still completes the static command tree on a box whose service is
# down. The shell reads stdout as a word list and has no way to show an error, so
# stderr is dropped and the exit status is always 0.
if [ "${1:-}" = "complete" ]; then
  EXPR="Kelix.Control.CLI.rpc_main([${ARGS}])"
  "$DIR/kelixip" rpc "$EXPR" 2>/dev/null && exit 0
  "$DIR/kelixip" eval "$EXPR" 2>/dev/null
  exit 0
fi

MODE=rpc
if [ $# -eq 0 ]; then MODE=eval; fi
case "${1:-}" in
  help | -h | --help) MODE=eval ;;
esac
if [ $# -eq 2 ] && [ "$2" = "help" ]; then
  case "$1" in
    registration | domain | mediaserver | module) MODE=eval ;;
  esac
fi

exec "$DIR/kelixip" "$MODE" "Kelix.Control.CLI.rpc_main([${ARGS}])"
